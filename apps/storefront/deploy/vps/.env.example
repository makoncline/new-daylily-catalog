# Image selection
IMAGE_TAG=main-00000000

# This deployment-owned value selects one seller. Do not put a seller ID in
# application source or in the generic image.
STOREFRONT_SELLER_ID=

# Data source
TURSO_DATABASE_URL=libsql://replace-me.turso.io
TURSO_DATABASE_AUTH_TOKEN=

# Contact and cart mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_BCC_EMAIL=

# Optional snapshot controls
PUBLIC_SNAPSHOT_DIR=/app/.public-data
PUBLIC_SNAPSHOT_REFRESH_TOKEN=
