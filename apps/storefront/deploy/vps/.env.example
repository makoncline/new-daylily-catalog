# Image selection
IMAGE_TAG=main-00000000

# This deployment-owned value selects one seller. Do not put a seller ID in
# application source or in the generic image.
STOREFRONT_SELLER_ID=

# The storefront reads only the main catalog storefront API.
STOREFRONT_DATA_SOURCE=remote
STOREFRONT_API_BASE_URL=https://daylilycatalog.com

# Send cart and contact inquiries to the approved HTTP delivery service.
STOREFRONT_INQUIRY_ADAPTER=remote
STOREFRONT_INQUIRY_URL=
STOREFRONT_INQUIRY_TOKEN=
