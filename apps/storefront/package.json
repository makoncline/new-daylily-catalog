{
  "name": "@daylily-catalog/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint src tests",
    "start": "next start",
    "pretest": "pnpm --filter @daylily-catalog/storefront-contract test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:attach": "BASE_URL=http://localhost:3200 playwright test",
    "pretypecheck": "pnpm --filter @daylily-catalog/storefront-contract typecheck && pnpm --filter @daylily-catalog/ui typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daylily-catalog/config": "workspace:*",
    "@daylily-catalog/storefront-contract": "workspace:*",
    "@daylily-catalog/ui": "workspace:*",
    "lucide-react": "^0.542.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
