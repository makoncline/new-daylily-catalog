# Select the brand and seller. The seller ID is server-only.
STOREFRONT_SITE_KEY="rolling-oaks"
STOREFRONT_HOSTNAME="rolling-oaks-daylilies.makon.dev"
STOREFRONT_SELLER_ID=""

# Production reads only the remote storefront API. Local development and tests
# use fixture/stub defaults when these values are not copied.
STOREFRONT_DATA_SOURCE="remote"
STOREFRONT_API_BASE_URL="https://daylilycatalog.com"

# Production derives the inquiry URL from the API base URL and seller ID.
STOREFRONT_INQUIRY_ADAPTER="remote"
STOREFRONT_INQUIRY_TOKEN=""
