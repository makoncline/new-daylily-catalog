# Environment schema for the Daylily Catalog app. Values for each stage are in
# .env.<stage>. Secrets come from 1Password Environments: "Daylily — Development"
# and, for `pnpm db:seed:publish`, "Daylily — Seed publish". See AGENTS.md.
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=true)
# @currentEnv=$APP_ENV
# @setValuesBulk(opLoadEnvironment(qmdcauwp5nowzitfojoko3llry), enabled=forEnv(development))
# @setValuesBulk(opLoadEnvironment(5765syaidz33wdovupnf67w5wm), enabled=$SEED_PUBLISH)
# @defaultRequired=false
# @defaultSensitive=false
# ---

# @type=enum(development)
APP_ENV=development

# Cloud and CI sign in to 1Password with this token. The Mac uses the desktop app.
# @type=opServiceAccountToken
OP_SERVICE_ACCOUNT_TOKEN=

# Loads the 1Password Environment "Daylily — Seed publish" for `pnpm db:seed:publish`.
# @type=boolean
SEED_PUBLISH=false

# @type=url
APP_BASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# @type=url
NEXT_PUBLIC_CLOUDFLARE_URL=
# @type=boolean
NEXT_PUBLIC_SENTRY_ENABLED=
NEXT_PUBLIC_POSTHOG_KEY=
# @type=url
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_ENVIRONMENT=

DATABASE_URL=
# @sensitive
TURSO_DATABASE_AUTH_TOKEN=
TURSO_EMBEDDED_REPLICA_URL=
TURSO_EMBEDDED_REPLICA_SYNC_URL=
TURSO_EMBEDDED_REPLICA_SYNC_INTERVAL_SECONDS=
# @sensitive
SEARCH_INDEX_CANDIDATE_TOKEN=
# @sensitive
VERCEL_AUTOMATION_BYPASS_SECRET=

# @sensitive
CLERK_SECRET_KEY=
# @sensitive
CLERK_WEBHOOK_SECRET=
DAYLILY_MCP_OAUTH_CLIENT_ID=
DAYLILY_MEMBER_API_OAUTH_CLIENT_IDS=
# @type=boolean
DAYLILY_TRUST_PROXY_IP=

# @sensitive
STRIPE_SECRET_KEY=
# @sensitive
STRIPE_WEBHOOK_SECRET=

# @sensitive
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
R2_ACCOUNT_ID=
# @sensitive
R2_ACCESS_KEY_ID=
# @sensitive
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# @type=url
R2_PUBLIC_BASE_URL=

# @sensitive
OPENAI_IMAGE_MODERATION_API_KEY=
# @sensitive
SENTRY_AUTH_TOKEN=

# @sensitive
SEED_R2_ACCESS_KEY_ID=
# @sensitive
SEED_R2_SECRET_ACCESS_KEY=
# @sensitive
SEED_R2_PUBLISH_ACCESS_KEY_ID=
# @sensitive
SEED_R2_PUBLISH_SECRET_ACCESS_KEY=
