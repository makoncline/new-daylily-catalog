# Environment schema for the Daylily Catalog app. Values for each stage are in
# .env.development and in the 1Password Environments "Daylily — Development" and
# "Daylily — Production". See AGENTS.md and docs/deploy-vps.md.
# @plugin(@varlock/1password-plugin)
# @initOp(token=$DAYLILY_OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=true)
# @currentEnv=$APP_ENV
# @setValuesBulk(opLoadEnvironment(qmdcauwp5nowzitfojoko3llry), enabled=forEnv(development))
# @setValuesBulk(opLoadEnvironment(kbms3dbpzhwvwiicxcnuh64uoa), enabled=forEnv(production))
# @defaultRequired=false
# @defaultSensitive=false
# ---

# @type=enum(development,production)
APP_ENV=development

# A read-only service account token for the selected stage. It does not use
# the standard OP_SERVICE_ACCOUNT_TOKEN name, so other `op` commands keep the
# personal account. Without it, the 1Password desktop app signs in.
# @type=opServiceAccountToken
DAYLILY_OP_SERVICE_ACCOUNT_TOKEN=

# @type=url
APP_BASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# @type=url
NEXT_PUBLIC_CLOUDFLARE_URL=
# @type=boolean
NEXT_PUBLIC_SENTRY_ENABLED=
NEXT_PUBLIC_POSTHOG_KEY=
# @type=url
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_ENVIRONMENT=

DATABASE_URL=
# @sensitive
TURSO_DATABASE_AUTH_TOKEN=
TURSO_EMBEDDED_REPLICA_URL=
TURSO_EMBEDDED_REPLICA_SYNC_URL=
TURSO_EMBEDDED_REPLICA_SYNC_INTERVAL_SECONDS=
# @sensitive
SEARCH_INDEX_CANDIDATE_TOKEN=
# @sensitive
VERCEL_AUTOMATION_BYPASS_SECRET=

# @sensitive
CLERK_SECRET_KEY=
# @sensitive
CLERK_WEBHOOK_SECRET=
DAYLILY_MCP_OAUTH_CLIENT_ID=
DAYLILY_MEMBER_API_OAUTH_CLIENT_IDS=
# @type=boolean
DAYLILY_TRUST_PROXY_IP=

# @sensitive
STRIPE_SECRET_KEY=
# @sensitive
STRIPE_WEBHOOK_SECRET=

# @sensitive
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
R2_ACCOUNT_ID=
# @sensitive
R2_ACCESS_KEY_ID=
# @sensitive
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# @type=url
R2_PUBLIC_BASE_URL=

# @sensitive
OPENAI_IMAGE_MODERATION_API_KEY=
# @sensitive
SENTRY_AUTH_TOKEN=

# @sensitive
SEED_R2_ACCESS_KEY_ID=
# @sensitive
SEED_R2_SECRET_ACCESS_KEY=
