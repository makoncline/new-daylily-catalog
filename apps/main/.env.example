# Development: use 1Password for secrets and .env.development.local for ordinary overrides.
# Deployment: copy this file to `.env`.
# See `docs/deploy-vps.md` for Docker and VPS details.

# Compose image selection
IMAGE_TAG="main-<shortsha>"

# Non-secrets
# Canonical public origin for metadata, robots, sitemap, feeds, and email links.
# Set this to the apex even while `prod.daylilycatalog.com` remains live for rollout/testing.
APP_BASE_URL="https://daylilycatalog.com"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLOUDFLARE_URL=""
NEXT_PUBLIC_SENTRY_ENABLED="false"
# Optional override. Vercel previews otherwise use VERCEL_ENV automatically.
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_POSTHOG_KEY="phc_test_key"
# US ingestion host or a verified managed-proxy URL. UI links stay on US PostHog.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
DAYLILY_MCP_OAUTH_CLIENT_ID=""
DAYLILY_MEMBER_API_OAUTH_CLIENT_IDS=""
R2_ACCOUNT_ID=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
R2_BUCKET_NAME="daylily-catalog-media"
R2_PUBLIC_BASE_URL="https://media.daylilycatalog.com"

# Database
# Turso/libSQL runtime: DATABASE_URL="libsql://..."
# Local SQLite runtime: DATABASE_URL="file:/data/daylilycatalog.sqlite"
DATABASE_URL=""
# Vercel Preview/Development may read the existing seeded-daylily-catalog Turso
# fixture directly. Production still requires local SQLite or an embedded replica.
# Public MCP database tools require a local source in every environment.
# Optional VPS-only Turso embedded replica. Keep DATABASE_URL as the remote libsql:// URL.
# Public page reads use this local file; dashboard reads and all writes still use DATABASE_URL.
TURSO_EMBEDDED_REPLICA_URL=""
TURSO_EMBEDDED_REPLICA_SYNC_INTERVAL_SECONDS="600"
# Authenticated scheduled search builds. Use a separate random token of at least 32 characters.
# SEARCH_INDEX_CANDIDATE_TOKEN=""

# Secrets. Development source: Daylily — Development in 1Password.
VERCEL_AUTOMATION_BYPASS_SECRET=""
TURSO_DATABASE_AUTH_TOKEN=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
# Enable only behind the tunnel-only VPS Caddy route that overwrites X-Daylily-Connecting-IP.
DAYLILY_TRUST_PROXY_IP="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Build-only
# Docker builds need:
# APP_BASE_URL (canonical apex public origin)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# NEXT_PUBLIC_CLOUDFLARE_URL
# NEXT_PUBLIC_SENTRY_ENABLED
# SENTRY_ENVIRONMENT
# NEXT_PUBLIC_POSTHOG_KEY
# NEXT_PUBLIC_POSTHOG_HOST
# DATABASE_URL
# TURSO_DATABASE_AUTH_TOKEN (required only when DATABASE_URL uses libsql://)
# Optional: STRIPE_SECRET_KEY for cold-cache-safe Stripe-derived metadata.
# SENTRY_AUTH_TOKEN=""

# Optional image moderation credential.
OPENAI_IMAGE_MODERATION_API_KEY=""
# OP_SERVICE_ACCOUNT_TOKEN belongs only in the cloud environment direct-variable UI.
# It must not be stored in an app env file or passed through Turbo.
