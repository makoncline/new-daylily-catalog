{
  "name": "@daylily-catalog/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
